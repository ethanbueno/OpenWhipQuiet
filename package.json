{
  "name": "openwhip",
  "version": "1.1.0",
  "description": "Whip Claude into shape",
  "license": "MIT",
  "main": "main.js",
  "bin": {
    "openwhip": "bin/openwhip.js",
    "badclaude": "bin/openwhip.js"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "electron",
    "tray",
    "overlay",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GitFrog1111/OpenWhip.git"
  },
  "bugs": {
    "url": "https://github.com/GitFrog1111/OpenWhip/issues"
  },
  "homepage": "https://github.com/GitFrog1111/OpenWhip#readme",
  "files": [
    "main.js",
    "preload.js",
    "overlay.html",
    "OpenWhip.vbs",
    "sounds",
    "icon",
    "bin/openwhip.js",
    "bin/badclaude.js",
    "README.md"
  ],
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "npm pack",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "koffi": "^2.16.3"
  },
  "build": {
    "appId": "com.ethanbueno.openwhip",
    "productName": "OpenWhip",
    "files": [
      "main.js",
      "preload.js",
      "overlay.html",
      "sounds/**",
      "icon/**",
      "!node_modules/koffi/build/koffi/!(win32_x64)/**"
    ],
    "electronLanguages": [
      "en-US"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon/Template.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "OpenWhip",
      "runAfterFinish": true
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "koffi@2.16.3": true
  },
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0"
  }
}
